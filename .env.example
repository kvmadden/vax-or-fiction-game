# Copy to .env.local. Every value is optional. With none set, solo play works anywhere and hosted rooms use the
# local WebSocket relay that `npm run dev` attaches to the Vite server.

# Origin printed on the join QR and lobby, e.g. your LAN address so phones on the same Wi-Fi can join a dev server.
# VITE_JOIN_BASE_URL=http://192.168.1.20:5173

# Explicit WebSocket origin for a relay started separately with `npm run relay`.
# VITE_WS_URL=ws://127.0.0.1:8787

# Standalone local relay (server/start-room-relay.mjs). Defaults to 127.0.0.1:8787.
# VOF_RELAY_HOST=127.0.0.1
# VOF_RELAY_PORT=8787

# Optional hosted relay on your own Supabase project. Apply supabase/migrations/ first (set the admin id in
# 20260927160000_vof_recap_privacy_lockdown.sql). Use the project's publishable (anon) key only. Never put a
# service-role key in a VITE_ variable: everything prefixed VITE_ ships in the browser bundle.
# VITE_PRODUCTION_RELAY=true
# VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
